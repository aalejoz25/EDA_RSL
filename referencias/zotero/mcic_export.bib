   month = {8},
   pages = {70-77},
   publisher = {IEEE},
   title = {Classification and Detection of Apple Leaf Disease Using DenseNet201 and YOLOV8},
   url = {http://dx.doi.org/10.1109/ICISC65841.2025.11188291},
