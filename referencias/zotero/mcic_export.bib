   keywords = {Convolutional Neural Networks,Disease severity classification,Horticulture,Hybrid models,Magnolia Scale,Plant disease assessment},
   month = {10},
   pages = {1-5},
   publisher = {IEEE},
   title = {Branching Out: A Simple 5-Level Classification of Magnolia Scale Diseases Using a Combination of CNN and DT Models},
